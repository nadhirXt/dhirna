{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dhirna",
  "version": "1.0.0",
  "identifier": "com.dhirna.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dhirna",
        "url": "index.html",
        "width": 1140,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "Dhirna — Alerte Focus",
        "url": "overlay.html",
        "width": 640,
        "height": 460,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis"],
    "publisher": "Dhirna",
    "copyright": "Copyright (c) 2026 Nadhir & Dhirna Contributors",
    "category": "Productivity",
    "shortDescription": "Dhirna — Focus Engine & Content Shield",
    "longDescription": "Open-source desktop distraction blocker, return-to-work timer, and local DNS content shield for Windows and Linux.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
